#!/usr/bin/env bash
# Validate that staged files inside skill subfolders are LF-terminated UTF-8 without a BOM.
# Enable with:  git config core.hooksPath .githooks

set -eu

errors=0
tmpdir=$(mktemp -d)
trap 'rm -rf "$tmpdir"' EXIT

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0

while IFS= read -r file; do
    [ -z "$file" ] && continue

    # Only files inside a subfolder (skill folders) — skip root-level files.
    case "$file" in
        */*) ;;
        *) continue ;;
    esac

    # Skip tooling/hidden folders.
    case "$file" in
        .git/*|.githooks/*|.idea/*|.vscode/*) continue ;;
    esac

    # Read staged blob (what is actually being committed) into a temp file.
    tmp="$tmpdir/blob"
    if ! git show ":$file" > "$tmp" 2>/dev/null; then
        continue
    fi

    # Skip empty files — nothing to validate.
    [ -s "$tmp" ] || continue

    # Skip binary files (null byte in first 8KiB).
    nulls=$(LC_ALL=C head -c 8192 "$tmp" | LC_ALL=C tr -d -c '\000' | wc -c | tr -d ' ')
    if [ "$nulls" -gt 0 ]; then
        continue
    fi

    # BOM check: first three bytes must not be EF BB BF.
    if [ "$(od -An -N3 -tx1 "$tmp" | tr -d ' \n')" = "efbbbf" ]; then
        echo "ERROR: $file has a UTF-8 BOM"
        errors=$((errors + 1))
    fi

    # CRLF check: any CR byte indicates non-LF endings.
    cr_count=$(LC_ALL=C tr -d -c '\r' < "$tmp" | wc -c | tr -d ' ')
    if [ "$cr_count" -gt 0 ]; then
        echo "ERROR: $file has CRLF (or CR) line endings"
        errors=$((errors + 1))
    fi

    # UTF-8 validity check.
    if ! iconv -f UTF-8 -t UTF-8 "$tmp" > /dev/null 2>&1; then
        echo "ERROR: $file is not valid UTF-8"
        errors=$((errors + 1))
    fi
done <<EOF
$staged
EOF

if [ "$errors" -gt 0 ]; then
    echo ""
    echo "Pre-commit validation failed ($errors error(s))."
    echo "Required for files under skill subfolders: LF line endings, UTF-8 encoding, no BOM."
    exit 1
fi

exit 0
